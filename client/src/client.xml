              <p className="text-base font-bold text-zinc-100">{task.task_type}</p>
              <p className="mt-1 text-sm text-zinc-300">Вулик: {task?.hive_id?.qr_code ?? '—'}</p>
              <p className="mt-1 text-sm text-zinc-300">
